#!/usr/bin/env zsh

# Render shared + optional private sources and atomically install the managed
# files into HOME.  No generated file contains a reference back to this repo.

emulate -LR zsh
setopt ERR_EXIT NO_UNSET PIPE_FAIL
umask 077

typeset script_file="${${(%):-%x}:A}"
typeset script_dir="${script_file:h}"
typeset script_name="${script_file:t}"
typeset source_arg="${script_dir:h}"
typeset home_arg="${HOME:-}"
typeset platform_arg="${DOTFILES_PLATFORM:-}"
typeset -i dry_run=0 check_only=0 show_diff=0

usage() {
  print -u2 -- "用法：$script_name [选项]"
  print -u2 -- "  --dry-run             只渲染并显示将要写入的目标"
  print -u2 -- "  --check               检查 HOME 是否与渲染结果一致，不写入"
  print -u2 -- "  --diff                显示渲染结果与 HOME 的 unified diff"
  print -u2 -- "  --platform darwin|linux  覆盖平台检测"
  print -u2 -- "  --home PATH           覆盖目标 HOME"
  print -u2 -- "  --source PATH         覆盖仓库源码目录"
  print -u2 -- "  --help                显示帮助"
  exit 2
}

while (( $# > 0 )); do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --check) check_only=1 ;;
    --diff) show_diff=1 ;;
    --platform)
      (( $# >= 2 )) || usage
      platform_arg="$2"
      shift
      ;;
    --home)
      (( $# >= 2 )) || usage
      home_arg="$2"
      shift
      ;;
    --source)
      (( $# >= 2 )) || usage
      source_arg="$2"
      shift
      ;;
    --help|-h) usage ;;
    *) print -u2 -- "错误：未知选项：$1"; usage ;;
  esac
  shift
done

[[ -n "$home_arg" && "$home_arg" == /* && "$home_arg" != "/" ]] \
  || { print -u2 -- "错误：HOME 目录无效：$home_arg"; exit 1; }
[[ -d "$home_arg" ]] \
  || { print -u2 -- "错误：HOME 目录不存在：$home_arg"; exit 1; }
[[ ! -L "$home_arg" ]] \
  || { print -u2 -- "错误：HOME 目录不能是符号链接：$home_arg"; exit 1; }
home_arg="${home_arg:A}"

[[ -n "$source_arg" && "$source_arg" == /* && "$source_arg" != "/" ]] \
  || { print -u2 -- "错误：源码目录无效：$source_arg"; exit 1; }
[[ -d "$source_arg" ]] \
  || { print -u2 -- "错误：源码目录不存在：$source_arg"; exit 1; }
[[ ! -L "$source_arg" ]] \
  || { print -u2 -- "错误：源码目录不能是符号链接：$source_arg"; exit 1; }
source_arg="${source_arg:A}"

export DOTFILES_SOURCE_DIR="$source_arg"
export DOTFILES_SCRIPT_DIR="$script_dir"
export DOTFILES_PLATFORM="$platform_arg"
source "$script_dir/dotfiles-common.zsh"
platform_arg="$(dotfiles_detect_platform)"
source "$script_dir/managed-targets.zsh"
dotfiles_load_targets "$platform_arg"

typeset private_dir="$source_arg/private"
dotfiles_normalize_private_permissions "$private_dir"
dotfiles_reject_symlinks_in_tree "$source_arg/apps" "apps 源码"
typeset manifest="$source_arg/apps/zsh/manifest.toml"

typeset stage_dir=""
cleanup() {
  [[ -z "${stage_dir:-}" || ! -d "$stage_dir" ]] || command rm -rf "$stage_dir"
}
trap cleanup EXIT HUP INT TERM
stage_dir="$(command mktemp -d "${TMPDIR:-/tmp}/dotfiles-apply.XXXXXX")" \
  || { print -u2 -- "错误：无法创建渲染临时目录"; exit 1; }
command chmod 700 "$stage_dir"

# 输出文件作为第四个参数传入；调用处清楚地表达 shared/platform/private 的顺序。
append_manifest_group_to() {
  local section="$1"
  local group="$2"
  local root="$3"
  local output="$4"
  local fragment fragment_path
  dotfiles_manifest_sources "$manifest" "$section" "$group"
  for fragment in "${DOTFILES_MANIFEST_SOURCES[@]}"; do
    dotfiles_is_safe_relative_path "$fragment" \
      || dotfiles_die "manifest 片段路径不安全：$fragment"
    fragment_path="$root/$fragment"
    dotfiles_append_fragment "$fragment_path" "$output"
  done
}

append_private_manifest_group_to() {
  local section="$1"
  local output="$2"
  local fragment fragment_path
  dotfiles_manifest_sources "$manifest" "$section" private
  for fragment in "${DOTFILES_MANIFEST_SOURCES[@]}"; do
    dotfiles_is_safe_relative_path "$fragment" \
      || dotfiles_die "manifest 私有片段路径不安全：$fragment"
    fragment_path="$private_dir/zsh/$fragment"
    if [[ -e "$fragment_path" || -L "$fragment_path" ]]; then
      dotfiles_append_fragment "$fragment_path" "$output"
    fi
  done
}

render_zsh_target() {
  local section="$1"
  local output="$2"
  print -r -- "# Generated by scripts/apply-dotfiles.zsh; edit apps/zsh or private/zsh." >> "$output"
  print -r >> "$output"
  append_manifest_group_to "$section" shared "$source_arg/apps/zsh" "$output"
  append_manifest_group_to "$section" "$platform_arg" "$source_arg/apps/zsh" "$output"
  append_private_manifest_group_to "$section" "$output"
}

render_plain_target() {
  local renderer="$1"
  local output="$2"
  local shared_path private_path comment
  case "$renderer" in
    zimrc)
      shared_path="$source_arg/apps/zsh/shared/modules/zim.zsh"
      comment="# Generated by scripts/apply-dotfiles.zsh; edit apps/zsh/shared/modules/zim.zsh."
      ;;
    vimrc)
      shared_path="$source_arg/apps/vim/vimrc"
      private_path="$private_dir/vim/vimrc"
      comment='" Generated by scripts/apply-dotfiles.zsh; edit apps/vim or private/vim.'
      ;;
    gitconfig)
      shared_path="$source_arg/apps/git/gitconfig"
      private_path="$private_dir/git/gitconfig"
      comment="# Generated by scripts/apply-dotfiles.zsh; edit apps/git or private/git."
      ;;
    npmrc)
      shared_path="$source_arg/apps/npm/npmrc"
      private_path="$private_dir/npm/npmrc"
      comment="# Generated by scripts/apply-dotfiles.zsh; edit apps/npm or private/npm."
      ;;
    ssh_config)
      shared_path="$source_arg/apps/ssh/config"
      private_path="$private_dir/ssh/config"
      comment="# Generated by scripts/apply-dotfiles.zsh; edit apps/ssh or private/ssh."
      ;;
    gh_config)
      shared_path="$source_arg/apps/gh/config.yml"
      comment="# Generated by scripts/apply-dotfiles.zsh; edit apps/gh/config.yml."
      ;;
    *) dotfiles_die "未知 renderer：$renderer" ;;
  esac

  print -r -- "$comment" >> "$output"
  print -r >> "$output"
  dotfiles_append_fragment "$shared_path" "$output"
  if [[ -n "${private_path:-}" && ( -e "$private_path" || -L "$private_path" ) ]]; then
    dotfiles_append_fragment "$private_path" "$output"
  fi
}

render_target() {
  local renderer="$1"
  local output="$2"
  : > "$output" || dotfiles_die "无法创建渲染文件：$output"
  case "$renderer" in
    zshrc) render_zsh_target interactive "$output" ;;
    zprofile) render_zsh_target profile "$output" ;;
    *) render_plain_target "$renderer" "$output" ;;
  esac
}

typeset -a stage_paths=()
typeset -i i=1
typeset relative_path renderer mode stage_path target_path
for relative_path in "${DOTFILES_MANAGED_TARGETS[@]}"; do
  renderer="${DOTFILES_MANAGED_RENDERERS[$i]}"
  mode="${DOTFILES_MANAGED_MODES[$i]}"
  stage_path="$stage_dir/$relative_path"
  command mkdir -p -m 700 "${stage_path:h}"
  render_target "$renderer" "$stage_path"
  command chmod "$mode" "$stage_path"
  stage_paths+=("$stage_path")
  (( i += 1 ))
done

typeset -i mismatches=0
i=1
for relative_path in "${DOTFILES_MANAGED_TARGETS[@]}"; do
  target_path="$home_arg/$relative_path"
  stage_path="${stage_paths[$i]}"
  mode="${DOTFILES_MANAGED_MODES[$i]}"

  if (( show_diff )); then
    if [[ -L "$target_path" ]]; then
      print -r -- "--- $target_path (symbolic link)"
      print -r -- "+++ rendered file"
    elif dotfiles_is_special_file "$target_path"; then
      dotfiles_die "目标路径是特殊文件，拒绝读取：$target_path"
    elif [[ -e "$target_path" && ! -d "$target_path" ]]; then
      if ! command diff -u "$target_path" "$stage_path"; then :; fi
    else
      print -r -- "--- $target_path"
      print -r -- "+++ rendered"
      if ! command diff -u /dev/null "$stage_path"; then :; fi
    fi
  fi

  if [[ -L "$target_path" ]]; then
    (( mismatches += 1 ))
    if (( dry_run )); then
      print -r -- "将替换符号链接：$target_path"
    elif (( ! check_only )); then
      print -r -- "将替换符号链接：$target_path"
    fi
  elif [[ ! -e "$target_path" ]]; then
    (( mismatches += 1 ))
    if (( dry_run )); then
      print -r -- "将创建：$target_path"
    elif (( ! check_only )); then
      print -r -- "将创建：$target_path"
    fi
  elif [[ -d "$target_path" && ! -L "$target_path" ]]; then
    dotfiles_die "目标路径是目录，拒绝覆盖：$target_path"
  elif dotfiles_is_special_file "$target_path"; then
    dotfiles_die "目标路径是特殊文件，拒绝覆盖：$target_path"
  else
    if ! command cmp -s "$target_path" "$stage_path"; then
      (( mismatches += 1 ))
      if (( dry_run )); then
        print -r -- "将更新：$target_path"
      elif (( ! check_only )); then
        print -r -- "将更新：$target_path"
      fi
    fi
    if [[ "$(dotfiles_mode "$target_path")" != "$mode" ]]; then
      (( mismatches += 1 ))
      if (( dry_run )); then
        print -r -- "将修正权限：$target_path -> $mode"
      elif (( ! check_only )); then
        print -r -- "将修正权限：$target_path -> $mode"
      fi
    fi
  fi
  (( i += 1 ))
done

# 所有父目录和现有目标先统一预检，避免在发现后续符号链接/非目录时留下
# 前面目标已经写入的半成品；dry-run/check 也因此能提前报告安全问题。
for relative_path in "${DOTFILES_MANAGED_TARGETS[@]}"; do
  target_path="$home_arg/$relative_path"
  dotfiles_validate_parent_chain "$target_path" "$home_arg"
  if [[ -d "$target_path" && ! -L "$target_path" ]]; then
    dotfiles_die "目标路径是目录，拒绝覆盖：$target_path"
  fi
  if [[ ! -L "$target_path" ]] && dotfiles_is_special_file "$target_path"; then
    dotfiles_die "目标路径是特殊文件，拒绝覆盖：$target_path"
  fi
done

if (( check_only )); then
  if (( mismatches )); then
    print -u2 -- "检查失败：$mismatches 个目标内容或权限不一致。"
    exit 1
  fi
  print -- "检查通过：所有目标内容和权限一致。"
  exit 0
fi

if (( dry_run )); then
  print -- "dry-run：未写入 HOME（$mismatches 个目标需要变更）。"
  exit 0
fi

typeset temp_file parent
i=1
for relative_path in "${DOTFILES_MANAGED_TARGETS[@]}"; do
  target_path="$home_arg/$relative_path"
  stage_path="${stage_paths[$i]}"
  parent="${target_path:h}"
  command mkdir -p -m 700 "$parent" \
    || dotfiles_die "无法创建目标父目录：$parent"
  [[ ! -L "$parent" ]] \
    || dotfiles_die "目标父目录是符号链接，拒绝写入：$parent"
  if [[ -d "$target_path" && ! -L "$target_path" ]]; then
    dotfiles_die "目标路径是目录，拒绝覆盖：$target_path"
  fi
  temp_file="$(command mktemp "$parent/.dotfiles.XXXXXX")" \
    || dotfiles_die "无法创建目标临时文件：$parent"
  if ! command cp "$stage_path" "$temp_file" \
      || ! command chmod "${DOTFILES_MANAGED_MODES[$i]}" "$temp_file"; then
    [[ ! -e "$temp_file" ]] || command rm -f "$temp_file"
    dotfiles_die "无法原子写入目标：$target_path"
  fi
  # mv 在 BSD/GNU 上都可能把“指向目录的目标符号链接”当成目录进入；
  # 先只删除目标链接本身，绝不让写入跟随到链接外部。
  if [[ -L "$target_path" ]]; then
    command rm -f "$target_path" \
      || { command rm -f "$temp_file"; dotfiles_die "无法替换目标符号链接：$target_path"; }
  fi
  command mv "$temp_file" "$target_path" \
    || { [[ ! -e "$temp_file" ]] || command rm -f "$temp_file"; dotfiles_die "无法原子写入目标：$target_path"; }
  (( i += 1 ))
done

print -- "应用完成：$platform_arg（${#DOTFILES_MANAGED_TARGETS[@]} 个目标）。"
