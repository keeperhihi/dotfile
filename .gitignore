# 本机私有源码：永远不进入 Git。
private/

# 应用凭据与运行时状态。
.config/gh/hosts.yml
.config/gh/hosts.yml.*
.git-credentials
.gitconfig.lock
.ssh/known_hosts
.ssh/known_hosts.old
.viminfo
.viminfo.tmp
.net?rwhist
*.viminfo
*.swp
*.swo
*~

# 本机密钥与敏感材料。
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Shell 与应用缓存及生成状态。
.cache/
.zim/
*.zwc
.zcompdump*
.zhistory
.zsh_history
.npm/_cacache/
.npm/_logs/
.DS_Store
Thumbs.db
.dotfiles.*
.local/state/dotfiles-backups/

# 临时 HOME 位于仓库根目录时生成的目标。
/.zshrc
/.zprofile
/.zimrc
/.vimrc
/.gitconfig
/.npmrc
/.ssh/config
/.config/gh/config.yml

# 仓库内意外生成的备份。
dotfiles-*.tar.gz
dotfiles-*.tar.gz.sha256
